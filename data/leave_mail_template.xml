<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_leave_approved" model="mail.template">
            <field name="name">Leave Approved Notification</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="subject">Your Leave Request Has Been Approved</field>
            <field name="email_to">{{ object.employee_id.work_email }}</field>
            <field name="description">Sent to employee when leave is approved</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Hello
                        <t t-out="object.employee_id.name"/>,
                    </p>
                    <p>✅ Your leave request has been
                        <b style="color:green;">approved</b>.
                    </p>
                    <p>
                        <b>Leave Type:</b>
                        <t t-out="object.holiday_status_id.name"/>
                        <br/>
                        <b>Start Date:</b>
                        <t t-out="object.request_date_from"/>
                        <br/>
                        <b>End Date:</b>
                        <t t-out="object.request_date_to"/>
                    </p>
                    <p>Thank you.</p>
                </div>
            </field>
        </record>
        <record id="email_template_leave_rejected" model="mail.template">
            <field name="name">Leave Rejected Notification</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="subject">Your Leave Request Has Been Rejected</field>
            <field name="email_to">{{ object.employee_id.work_email }}</field>
            <field name="description">Sent to employee when leave is rejected</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Hello
                        <t t-out="object.employee_id.name"/>,
                    </p>
                    <p>❌ Your leave request has been
                        <b style="color:red;">rejected</b>.
                    </p>
                    <p>Please contact your manager for more information.</p>
                    <p>Thank you.</p>
                </div>
            </field>
        </record>
    </data>
</odoo>