<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- hr.employee inherited -->
    <record id="hr_employee_form_inherited" model="ir.ui.view">
        <field name="name">hr.employee.form.inherited</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <div class="oe_button_box">
                <button name="%(action_leave_count_button)d" type="action"  class="oe_stat_button">
                    <field name="leave_count" widget="statinfo" string="Leaves : "/>
                </button>
                <!--Leave Stat button -->
                <button class="oe_stat_button smart_button" >
                    <field name="leave_stats_display" widget="statinfo" string="Stats"/>
                </button>
            </div>
        </field>
    </record>
    <!--hr.leave
    inhertited-->
    <record id="hr_leave_view_form_inherited" model="ir.ui.view">
        <field name="name">hr.leave.view.form.inherited</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div name="button_box" class="oe_button_box"  groups="base.group_user" />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(action_leave_count_button)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-calendar">
                    <field name="leave_count" widget="statinfo" string="Leaves"/>
                </button>
                <!--Leave Stat button -->
                <button class="oe_stat_button smart_button" >
                    <field name="leave_stats_display" widget="statinfo" string="Stats"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='holiday_status_id']" position="after">
                <field name="reason_leave" />
                <field name="binary_file" filename="binary_file_name" />
            </xpath>
        </field>
    </record>
    <!--Views
    for Leave Tracker-->
    <!--search
    view-->
    <record id="view_leave_tracker_search" model="ir.ui.view">
        <field name="name">hr.leave.inherited.search</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_search_my" />
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator />
                <filter name="less_than_3" string="Less Than 3 Days"
                    domain="[('number_of_days', '&lt;', 3)]" />
                <filter name="less_than_week" string="Less Than a Week"
                    domain="[('number_of_days', '&lt;', 7)]" />
                <filter name="more_than_month" string="More Than a Month"
                    domain="[('number_of_days', '&gt;=', 30)]" />
            </xpath>
        </field>
    </record>
    <!--Tree
    view-->
    <record id="view_leave_tracker_tree_inherited" model="ir.ui.view">
        <field name="name">hr.leave.inherit.tree</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="reason_leave" />
                <field name="leave_health" widget="badge"
                    decoration-success="leave_health == 'good'"
                    decoration-warning="leave_health == 'warning'"
                    decoration-danger="leave_health == 'low'" />
            </xpath>
        </field>
    </record>
    <!--Kanban
    View-->
    <record id="view_leave_tracker_kanban" model="ir.ui.view">
        <field name="name">hr.leave.inherit.kanban</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="default_group_by">state</attribute>
                <attribute name="records_draggable">1</attribute>
            </xpath>
            <xpath expr="//strong[hasclass('o_kanban_record_title')]" position="replace">
                <div class="d-flex align-items-center mb-1">
                    <img
                        t-att-src="kanban_image('hr.employee', 'avatar_128', record.employee_id.raw_value)"
                        t-att-title="record.employee_id.value"
                        t-att-alt="record.employee_id.value"
                        class="rounded-circle me-2"
                        style="width:30px; height:30px; object-fit: cover;" />
                    <strong>
                        <field name="employee_id" />
                    </strong>
                </div>
            </xpath>
            <xpath expr="//div[hasclass('o_leave_kanban_name')]" position="after">
                <div class="text-muted small mt-1" t-if="record.reason_leave.raw_value">
                    <i class="fa fa-comment me-1" />
                    <field name="reason_leave" />
                </div>
                <div class="mt-2">
                    <field name="leave_health" widget="badge"
                        decoration-success="leave_health == 'good'"
                        decoration-warning="leave_health == 'warning'"
                        decoration-danger="leave_health == 'low'" />
                </div>
            </xpath>
        </field>
    </record>
    <!--========================
    Dashboard =====================-->
    <!--===============================================-->
    <!--Pivot
    View-->
    <record id="view_leave_tracker_pivot" model="ir.ui.view">
        <field name="name">hr.leave.inherit.pivot</field>
        <field name="model">hr.leave</field>
        <field name="arch" type="xml">
            <pivot string="Leave Summary" sample="1">
                <field name="employee_id" type="row" />
                <field name="date_from" type="col" interval="month" />
                <field name="department_id" type="col" />
                <field name="number_of_days" type="measure" />
            </pivot>
        </field>
    </record>
    <!-- Graph View -->
    <record id="view_leave_dashboard_graph" model="ir.ui.view">
        <field name="name">hr.leave.dashboard.graph</field>
        <field name="model">hr.leave</field>
        <field name="arch" type="xml">
            <graph string="Leaves per Month" type="bar">
                <field name="date_from" interval="month" />
                <field name="number_of_days" type="measure" />
            </graph>
        </field>
    </record>
    <!-- Pie  -->
    <record id="view_leave_dashboard_pie" model="ir.ui.view">
        <field name="name">hr.leave.dashboard.pie</field>
        <field name="model">hr.leave</field>
        <field name="arch" type="xml">
            <graph string="Leaves by Department" type="pie">
                <field name="department_id" />
                <field name="number_of_days" type="measure" />
            </graph>
        </field>
    </record>
</odoo>