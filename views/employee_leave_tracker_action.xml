<?xml version="1.0" encoding="UTF-8"?>
<odoo>
 

 <!-- Main Action -->
    <record id="action_employee_leave_request_tracker" model="ir.actions.act_window">
        <field name="name">Leave Tracker</field>
        <field name="res_model">hr.leave</field>
        <field name="view_mode">kanban,form,tree</field>
           <field name="view_id" ref="view_leave_tracker_tree_inherited"/>
           <field name="search_view_id" ref="view_leave_tracker_search"/>
    </record>


    <!--Analysis report action-->
    <record id="action_employee_leave_request_Analysis" model="ir.actions.act_window">
        <field name="name">Leave Analysis</field>
        <field name="res_model">hr.leave</field>
        <field name="view_mode">pivot</field>
    </record>

 
  <!-- Action  Dashboard-->
    <record id="action_leave_dashboard_minimal" model="ir.actions.act_window">
        <field name="name">Leave Dashboard</field>
        <field name="res_model">hr.leave</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_leave_dashboard_graph_minimal"/>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

</odoo>