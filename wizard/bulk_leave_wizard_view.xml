<odoo>

    <record id="view_bulk_leave_wizard_form" model="ir.ui.view">
        <field name="name">bulk.leave.wizard.form</field>
        <field name="model">bulk.leave.wizard</field>
        <field name="arch" type="xml">

            <form string="Bulk Leave Action">

                <group>
                    <field name="leave_ids"/>
                </group>

                <footer>

                    <button name="action_bulk_approve"
                            string="Approve Selected"
                            type="object"
                            class="btn-success"/>

                    <button name="action_bulk_refuse"
                            string="Reject Selected"
                            type="object"
                            class="btn-danger"/>

                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>

                </footer>

            </form>

        </field>
    </record>



</odoo>
